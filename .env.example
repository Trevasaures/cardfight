
FLASK_DEBUG=false

# Comma-separated frontend origins; blank disables cross-origin API access.
CARDFIGHT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# local = loopback single-user lab; oidc-dev = loopback login testing;
# oidc = HTTPS hosted identity. See docs/authentication-setup.md.
CARDFIGHT_AUTH_MODE=local
CARDFIGHT_AUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
CARDFIGHT_AUTH_ISSUER=
CARDFIGHT_AUTH_CLIENT_ID=
CARDFIGHT_AUTH_CLIENT_SECRET=
CARDFIGHT_AUTH_TRANSACTION_KEY=
CARDFIGHT_AUTH_RESTORE_EPOCH=
CARDFIGHT_AUTH_ADMISSION_HOLD=true
CARDFIGHT_AUTH_GOOGLE_CONNECTION=google-oauth2
CARDFIGHT_AUTH_EMAIL_CONNECTION=email

# Backups and migration checkpoints stay outside this checkout. If unset, use
# the per-user application-data directory. Set an absolute external directory.
# CARDFIGHT_BACKUP_DIR=C:/Users/you/OneDrive/Personal_projects/Vanguard/Backup_DBs

CARD_IMAGE_ANALYZER_PROVIDER=mock
CARD_IMAGE_ANALYZER_MODEL=

OPENAI_API_KEY=
